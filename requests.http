@base = http://localhost:7986/api

############################################################
# AUTH
############################################################

### 1. Register
POST {{base}}/auth/register
Content-Type: application/json

{
  "name": "Camila",
  "email": "camila@example.com",
  "password": "Secreta123!"
}

### 2. Verify email
# Copy the token from the console line:
#   "Verification link for camila@example.com: http://localhost:5173/verify-email?token=XXXX"
POST {{base}}/auth/verify-email
Content-Type: application/json

{ "token": "PASTE_VERIFICATION_TOKEN_HERE" }

### 3. Resend verification link (always 200)
POST {{base}}/auth/resend-verification
Content-Type: application/json

{ "email": "camila@example.com" }

### 4. Login (rememberMe = true -> token lasts 30 days, false -> 24 hours)
# @name login
POST {{base}}/auth/login
Content-Type: application/json

{
  "email": "camila@example.com",
  "password": "Secreta123!",
  "rememberMe": true
}

###
@token = {{login.response.body.$.accessToken}}

### 5. Who am I
GET {{base}}/auth/me
Authorization: Bearer {{token}}

############################################################
# TRIPS
############################################################

### 6. Create a trip (Camila is added automatically)
# @name createTrip
POST {{base}}/trips
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Santa Marta 2026",
  "category": "TRIP",
  "participants": ["Luis", "Sara"]
}

###
# Participants come sorted by name: Camila, Luis, Sara
@tripId = {{createTrip.response.body.$.id}}
@camila = {{createTrip.response.body.$.participants[0].id}}
@luis = {{createTrip.response.body.$.participants[1].id}}
@sara = {{createTrip.response.body.$.participants[2].id}}

### 7. List my trips
GET {{base}}/trips
Authorization: Bearer {{token}}

### 8. Add a participant
POST {{base}}/trips/{{tripId}}/participants
Authorization: Bearer {{token}}
Content-Type: application/json

{ "name": "Juan" }

############################################################
# EXPENSES
############################################################

### 9. Camila pays the hotel for everyone
POST {{base}}/trips/{{tripId}}/expenses
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "description": "Hotel",
  "amount": 320000,
  "date": "2026-10-10",
  "paidById": {{camila}},
  "splitAmongIds": [{{camila}}, {{luis}}, {{sara}}]
}

### 10. Luis pays groceries for everyone
POST {{base}}/trips/{{tripId}}/expenses
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "description": "Groceries",
  "amount": 85500,
  "date": "2026-10-11",
  "paidById": {{luis}},
  "splitAmongIds": [{{camila}}, {{luis}}, {{sara}}]
}

### 11. Sara pays a taxi for herself and Luis (no date = today)
# @name createTaxi
POST {{base}}/trips/{{tripId}}/expenses
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "description": "Taxi",
  "amount": 30000,
  "paidById": {{sara}},
  "splitAmongIds": [{{luis}}, {{sara}}]
}

### 12. List expenses
GET